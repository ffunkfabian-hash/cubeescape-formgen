{
  "name": "cubeescape-design",
  "version": {
    "file": "CHANGELOG.md",
    "pattern": "(?m)^## claude-(\\d+\\.\\d+(?:\\.\\d+)?)"
  },
  "check": {
    "quick": [
      [
        "python3",
        "-m",
        "py_compile",
        "claude/generator/eng.py",
        "claude/generator/raster.py",
        "claude/generator/views.py",
        "claude/generator/xl.py",
        "claude/generator/xlroles.py",
        "claude/generator/sheetmodels.py",
        "claude/generator/export_spec.py",
        "claude/generator/skins.py",
        "claude/generator/skinraster.py",
        "claude/generator/variants.py",
        "claude/generator/jlib.py",
        "claude/generator/new_variant.py",
        "claude/generator/spec_checks.py",
        "claude/generator/vsmodels.py",
        "claude/generator/export_sight.py",
        "claude/generator/vsheet.py",
        "claude/generator/build_vs.py",
        "claude/generator/vsmount.py",
        "claude/generator/sheetcache.py",
        "claude/generator/texcat.py",
        "claude/generator/texprofile.py",
        "claude/generator/wtypes.py",
        "claude/generator/tlib.py",
        "claude/generator/ops.py",
        "claude/generator/sketch.py",
        "claude/generator/export_geo.py",
        "claude/generator/test_geo_spec.py"
      ],
      [
        "python3",
        "claude/generator/test_spec.py"
      ],
      [
        "python3",
        "claude/generator/export_sight.py",
        "--check"
      ],
      [
        "python3",
        "claude/generator/test_sight_spec.py"
      ],
      [
        "python3",
        "claude/generator/export_geo.py"
      ],
      [
        "python3",
        "claude/generator/test_geo_spec.py"
      ],
      [
        "python3",
        "claude/tests/test_golden.py"
      ],
      [
        "python3",
        "claude/tests/test_sheetcache.py"
      ],
      [
        "python3",
        "claude/tests/test_texcat.py"
      ],
      [
        "python3",
        "-m",
        "py_compile",
        "docs/textures/make_swatches.py",
        "docs/textures/check_catalog.py"
      ],
      [
        "python3",
        "docs/textures/check_catalog.py"
      ]
    ],
    "full": [
      [
        "python3",
        "claude/generator/build_all.py",
        "--nur-xl",
        "--release"
      ],
      [
        "python3",
        "claude/tests/test_golden.py",
        "--full"
      ]
    ],
    "nightly": [
      [
        "./ce",
        "lock",
        "gpu",
        "--",
        "python3",
        "claude/generator/build_all.py",
        "--nur-xl",
        "--force"
      ],
      [
        "./ce",
        "lock",
        "gpu",
        "--",
        "python3",
        "claude/tests/test_golden.py",
        "--full"
      ]
    ]
  },
  "docs": {
    "changelog": "CHANGELOG.md",
    "dir": "claude/docs",
    "agent_sections": [],
    "agent_sections_reason": "Getrennte Claude-/Codex-Regeln mit bestehender Bullet-Gliederung; keine erzwungene Umsortierung für den Werkzeug-Rollout."
  },
  "owners": {
    "claude/": "Claude",
    "codex/": "Codex",
    "docs/": "gemeinsam – nur auf Wunsch des Nutzers",
    "Wurzel (README.md, CHANGELOG.md, AGENTS.md, CLAUDE.md, .ce-repo.json, .github/)": "Claude; Codex meldet Änderungswünsche"
  },
  "release": {
    "branch_prefix": "release/",
    "tag_prefix": "claude-v",
    "note": "Release per Branch release/claude-<version>"
  },
  "heavy_lock": true,
  "coordination": {
    "repo": "ffunkfabian-hash/cubeescape-nexogen",
    "registry": "https://github.com/ffunkfabian-hash/cubeescape-nexogen/blob/main/repos.json"
  },
  "tools_version": {
    "version": "0.22.0",
    "commit": "9f1ed12072c8807d3cd0b26370e792bd4249f762"
  },
  "tidy": {
    "paths": [
      {
        "name": "Generator-Zwischenstände claude/generator/reg",
        "root": "claude/generator/reg",
        "glob": "*",
        "keep": 50,
        "older_than_days": 30
      },
      {
        "name": "Generator-Blätter claude/generator/final",
        "root": "claude/generator/final",
        "glob": "*",
        "keep": 50,
        "older_than_days": 30
      }
    ]
  }
}
